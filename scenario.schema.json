{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conversation scenario",
  "description": "A practice conversation: who is talking, in what setting, and which moments matter.",
  "type": "object",
  "required": ["id", "title", "version", "language", "setting", "participant", "counterpart", "objective", "opening_message", "key_moments"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "setting": {
      "type": "object",
      "required": ["situation", "channel"],
      "additionalProperties": false,
      "properties": {
        "situation": { "type": "string", "minLength": 10 },
        "channel": { "enum": ["voice", "text", "video"] },
        "max_turns": { "type": "integer", "minimum": 2 }
      }
    },
    "participant": {
      "type": "object",
      "required": ["role", "brief"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "brief": { "type": "string", "minLength": 10 }
      }
    },
    "counterpart": {
      "type": "object",
      "required": ["name", "role", "background", "starting_mood"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "background": { "type": "string", "minLength": 10 },
        "starting_mood": { "type": "string", "minLength": 1 }
      }
    },
    "objective": { "type": "string", "minLength": 10 },
    "opening_message": { "type": "string", "minLength": 1 },
    "key_moments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
